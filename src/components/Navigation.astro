<script src="https://kit.fontawesome.com/ae2377133e.js" crossorigin="anonymous"></script>
<script>
  // Can I move this to TS? This is clunky
  var dropdowns = document.getElementsByClassName("dropdown-button");
  // Also, this shouldn't be one big fat [0] that's icky
  var dropdownContainer = document.getElementsByClassName("dropdown-container")[0];
  for (var i = 0; i < dropdowns.length; i++)
  {
    var dropdown = dropdowns[i];
    dropdown.addEventListener("click", function() {
      if (window.getComputedStyle(dropdownContainer).display === "block")
      {
        dropdownContainer.setAttribute("style", "display: none");
      }
      else
      {
        dropdownContainer.setAttribute("style", "display: block");
      }

        // TODO still don't like this 0-index dependence. Would also like a smooth animation
        // also abstract out to a function, also why is there a newline
        var rightArrow = document.getElementsByClassName("right-arrow")[0];
        var downArrow = document.getElementsByClassName("down-arrow")[0];
        if (window.getComputedStyle(rightArrow).display === "block")
        {
          rightArrow.setAttribute("style", "display: none");
          downArrow.setAttribute("style", "display: block");
        }
        else
        {
          rightArrow.setAttribute("style", "display: block");
          downArrow.setAttribute("style", "display: none");
        }

    });
  }
</script>
